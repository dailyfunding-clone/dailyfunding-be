# Django (SECRET_KEY, BANK_WEBHOOK_SECRET required — boot fails without them)
SECRET_KEY=dev-secret-key-change-me-32bytes-minimum!!
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Database
DB_NAME=dailyfunding
DB_USER=cyjoon
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_EAGER=1

# mockbank -> API webhook channel
MOCKBANK_API_BASE=http://127.0.0.1:8000
BANK_WEBHOOK_SECRET=dev-bank-secret
